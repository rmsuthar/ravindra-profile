{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ravindra-profile",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "ravindra.lets.gen.in",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
